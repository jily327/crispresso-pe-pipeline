        "used_group_b_count": {
          "minimum": 0,
          "title": "Used Group B Count",
          "type": "integer"
        },
        "used_group_b_sample_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"

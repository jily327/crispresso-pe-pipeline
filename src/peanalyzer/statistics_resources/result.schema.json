      "additionalProperties": false,
      "properties": {
        "dpi": {
          "minimum": 0,
          "title": "Dpi",
          "type": "integer"
        },
        "editor": {
          "minLength": 1,
          "title": "Editor",
          "type": "string"
        },
        "treatment": {
          "minLength": 1,
          "title": "Treatment",
          "type": "string"
        }
      },
      "required": [
        "editor",
        "treatment",
        "dpi"
      ],
      "title": "Condition",
      "type": "object"
    },
    "ContrastResult": {

      "properties": {
        "alternative": {
          "const": "two-sided",
          "title": "Alternative",
          "type": "string"
        },
        "complete_blocks": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",

          },
          "title": "Complete Blocks",
          "type": "array"
        },
        "contrast_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Contrast Id",
          "type": "string"
        },
        "copy_name": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Copy Name"
        },
        "difference_in_biological_sample_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Difference In Biological Sample Fraction"
        },
        "excluded_blocks": {

          "type": "string"
        },
        "target_name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Target Name",
          "type": "string"
        },
        "used_group_a_count": {
          "minimum": 0,
          "title": "Used Group A Count",
          "type": "integer"
        },
        "used_group_a_sample_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",

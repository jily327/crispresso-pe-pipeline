        "authoritative_fields": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Authoritative Fields",
          "type": "object"
        },
        "n_deleted": {
          "minimum": 0,
          "title": "N Deleted",
          "type": "integer"
        },
        "n_inserted": {
          "minimum": 0,
          "title": "N Inserted",
          "type": "integer"
        },
        "n_mutated": {
          "minimum": 0,
          "title": "N Mutated",
          "type": "integer"
        },
        "net_delta_bp": {
          "title": "Net Delta Bp",
          "type": "integer"
        },
        "product_class": {
          "enum": [
            "unmodified",
            "substitution_only",
            "indel_only",
            "indel_plus_substitution",
            "ambiguous",
            "discarded"
          ],
          "title": "Product Class",
          "type": "string"
        },
        "reads": {
          "minimum": 0,
          "title": "Reads",
          "type": "integer"
        }
      },
      "required": [
        "authoritative_fields",
        "reads",
        "n_inserted",
        "n_deleted",
        "n_mutated",
        "net_delta_bp",
        "product_class"
      ],
      "title": "Allele",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "dpi": {
          "minimum": 0,
          "title": "Dpi",
          "type": "integer"
        },
        "editor": {
          "minLength": 1,
          "title": "Editor",
          "type": "string"
        },
        "treatment": {
          "minLength": 1,
          "title": "Treatment",
          "type": "string"
        }
      },
      "required": [
        "editor",
        "treatment",
        "dpi"
      ],
      "title": "Condition",
      "type": "object"
    },
    "ContrastResult": {

          "type": "array"
        },
        "used_group_b_count": {
          "minimum": 0,
          "title": "Used Group B Count",
          "type": "integer"
        },
        "used_group_b_sample_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Used Group B Sample Ids",
          "type": "array"
        },
        "valid_tests_in_family": {
          "minimum": 0,
          "title": "Valid Tests In Family",
          "type": "integer"
        }
      },
      "required": [
        "target_name",
        "metric_name",
        "population_scope",
        "routing_conditioned",
        "contrast_id",
        "family_id",
        "group_a",
        "group_b",
        "pairing_mode",
        "alternative",
        "expected_group_a",
        "expected_group_b",
        "expected_group_a_count",
        "expected_group_b_count",
        "used_group_a_sample_ids",
        "used_group_b_sample_ids",
        "used_group_a_count",
        "used_group_b_count",
        "complete_blocks",
        "excluded_blocks",
        "status",
        "reason_codes",
        "difference_in_biological_sample_fraction",
        "p_value",
        "q_value",
        "valid_tests_in_family",
        "permutation_space_size",
        "permutation_count",
        "extreme_count"
      ],
      "title": "ContrastResult",
      "type": "object"
    },
    "ExcludedBlock": {

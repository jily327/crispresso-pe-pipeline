        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Nuclease Profile"
    },
    "quantification_window_coordinates": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quantification Window Coordinates"
    },
    "target_name": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Target Name",
      "type": "string"
    },
    "tigr_target_sequence": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
